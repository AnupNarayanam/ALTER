{
  "//": "SwayNC config — spec: dark, rounded, red border, minimal. Positioned top-right so it doesn't collide with waybar's own right-zone modules below it.",

  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-margin-top": 8,
  "control-center-margin-right": 8,
  "notification-window-width": 340,

  "timeout": 6,
  "timeout-low": 4,
  "timeout-critical": 0,

  "notification-icon-size": 32,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,

  "fit-to-screen": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",

  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],

  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "Do Not Disturb"
    }
  }
}
